{
  "info": {
    "_postman_id": "bdf0011a-1122-4433-8899-abcdef012345",
    "name": "Blood Donor Emergency Response Platform API",
    "description": "Comprehensive Postman test suite for Real-Time Blood Donor Emergency Response Platform.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "donorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "hospitalToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "responseId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register Donor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.donor@example.com\",\n  \"password\": \"Donor@12345\",\n  \"role\": \"donor\",\n  \"phone\": \"+919876500001\",\n  \"bloodGroup\": \"O+\",\n  \"dateOfBirth\": \"1998-05-15\",\n  \"weight\": 68,\n  \"hasChronicIllness\": false,\n  \"street\": \"12 MG Road\",\n  \"area\": \"Indiranagar\",\n  \"city\": \"Bengaluru\",\n  \"pincode\": \"560038\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Register Hospital",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"City Care Super Specialty Hospital\",\n  \"email\": \"citycare@hospital.org\",\n  \"password\": \"Hosp@12345\",\n  \"role\": \"hospital\",\n  \"phone\": \"+918025252525\",\n  \"hospitalName\": \"City Care Super Specialty Hospital\",\n  \"licenseNumber\": \"HOSP-KA-BLR-2024-8891\",\n  \"contactPerson\": \"Dr. Arvind Sharma\",\n  \"emergencyPhone\": \"+919888877777\",\n  \"street\": \"45 Ring Road\",\n  \"area\": \"Indiranagar\",\n  \"city\": \"Bengaluru\",\n  \"pincode\": \"560038\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login Donor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.token) {",
                  "    pm.collectionVariables.set('donorToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.donor@example.com\",\n  \"password\": \"Donor@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login Hospital",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.token) {",
                  "    pm.collectionVariables.set('hospitalToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citycare@hospital.org\",\n  \"password\": \"Hosp@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.token) {",
                  "    pm.collectionVariables.set('adminToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@blooddonor.org\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Authenticated User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Hospital Management",
      "item": [
        {
          "name": "Get Hospital Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hospitalToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/hospital/profile",
              "host": ["{{baseUrl}}"],
              "path": ["hospital", "profile"]
            }
          }
        },
        {
          "name": "Create Emergency Blood Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.request._id) {",
                  "    pm.collectionVariables.set('requestId', res.data.request._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{hospitalToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientBloodGroup\": \"A+\",\n  \"requiredUnits\": 2,\n  \"urgency\": \"CRITICAL\",\n  \"patientCaseDetails\": \"Urgent emergency heart surgery patient requiring immediate transfusion\",\n  \"area\": \"Indiranagar\",\n  \"city\": \"Bengaluru\",\n  \"pincode\": \"560038\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hospital/requests",
              "host": ["{{baseUrl}}"],
              "path": ["hospital", "requests"]
            }
          }
        },
        {
          "name": "List Hospital Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hospitalToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/hospital/requests",
              "host": ["{{baseUrl}}"],
              "path": ["hospital", "requests"]
            }
          }
        },
        {
          "name": "Get Request Details (Matched Donors & Responses)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hospitalToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/hospital/requests/{{requestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["hospital", "requests", "{{requestId}}"]
            }
          }
        },
        {
          "name": "Verify and Finalize Donation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{hospitalToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unitsDonated\": 1,\n  \"remarks\": \"Donation completed at Blood Bank desk\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hospital/responses/{{responseId}}/verify-donation",
              "host": ["{{baseUrl}}"],
              "path": ["hospital", "responses", "{{responseId}}", "verify-donation"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Donor Operations",
      "item": [
        {
          "name": "Get Donor Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/donor/profile",
              "host": ["{{baseUrl}}"],
              "path": ["donor", "profile"]
            }
          }
        },
        {
          "name": "Toggle Availability",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/donor/availability",
              "host": ["{{baseUrl}}"],
              "path": ["donor", "availability"]
            }
          }
        },
        {
          "name": "View Compatible Emergency Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/donor/emergency-requests",
              "host": ["{{baseUrl}}"],
              "path": ["donor", "emergency-requests"]
            }
          }
        },
        {
          "name": "Respond to Emergency Request (ACCEPT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data._id) {",
                  "    pm.collectionVariables.set('responseId', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{donorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\",\n  \"responseNotes\": \"On my way, will reach in 15 minutes.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/donor/emergency-requests/{{requestId}}/respond",
              "host": ["{{baseUrl}}"],
              "path": ["donor", "emergency-requests", "{{requestId}}", "respond"]
            }
          }
        },
        {
          "name": "Get Donor Donation History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/donor/history",
              "host": ["{{baseUrl}}"],
              "path": ["donor", "history"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin Operations",
      "item": [
        {
          "name": "Get Admin Overview Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/overview",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "overview"]
            }
          }
        },
        {
          "name": "Get All Donors",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/donors",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "donors"]
            }
          }
        },
        {
          "name": "Get All Hospitals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/hospitals",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "hospitals"]
            }
          }
        },
        {
          "name": "Get All Emergency Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/requests",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "requests"]
            }
          }
        }
      ]
    }
  ]
}
